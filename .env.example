SS_MODE=all-in-one
SERVERSENTINEL_DATA_DIR=/data
SERVERSENTINEL_SERVERS_DOCKER_VOLUME=serversentinel-minecraft-servers
SERVERSENTINEL_NODE_IMAGE=nl2109/serversentinel:latest
SERVERSENTINEL_ENABLE_DEMO=false
SERVERSENTINEL_TRUST_PROXY=false
# Optional fixed first-run token. If empty, a random token is printed to the panel log.
SERVERSENTINEL_SETUP_TOKEN=
SERVERSENTINEL_FILE_DOWNLOAD_MAX_BYTES=536870912
SERVERSENTINEL_FILE_DOWNLOAD_ZIP_THRESHOLD_BYTES=134217728
SERVERSENTINEL_FILE_DOWNLOAD_ZIP_THRESHOLD_COUNT=10
SERVERSENTINEL_FILE_ZIP_MAX_ENTRIES=10000
SERVERSENTINEL_FILE_ZIP_MAX_EXPANDED_BYTES=536870912
VITE_SERVERSENTINEL_API_TARGET=http://localhost:8080
MODRINTH_API_KEY=
# MaxMind credentials for the Player insights module. They authorize the GeoLite2 City download
# only: the database is stored under SERVERSENTINEL_DATA_DIR/geoip and every lookup runs against
# that local file, so no player address is sent to MaxMind or to any other geolocation service.
# Settings takes precedence over these, and leaving them empty means the panel has no geography.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MCJARS_BASE_URL=https://mcjars.app
MCJARS_API_KEY=
DOCKER_SOCKET=/var/run/docker.sock
# Seconds Docker waits after SIGTERM before killing a Minecraft container, used by every stop
# serverSENTINEL does not drive through the Minecraft console, including the one the Docker daemon
# issues to all containers when it restarts. Keep it under the service manager's stop timeout for
# Docker, which is 90 seconds under the packaged systemd unit. Allowed range is 10 to 3600.
SERVERSENTINEL_MINECRAFT_STOP_TIMEOUT_SECONDS=60
PORT=8080
LOG_LEVEL=info
# IANA time zone for cron schedules and the panel display default (for example Europe/Vienna).
TZ=UTC
SERVERSENTINEL_BUILD_ID=
SS_BUILD_ID=

# Node-agent only. SS_MODE=node requires these settings.
# Prefer the Add Node flow in the panel, which generates short-lived
# join-token commands with the correct panel URL and host/container data path.
SS_PANEL_URL=
SS_NODE_NAME=
SS_JOIN_TOKEN=
SERVERSENTINEL_DOCKER_DATA_DIR=/opt/serversentinel/data
