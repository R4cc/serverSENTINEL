{
  "name": "@serversentinel/server",
  "version": "1.12.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm --prefix ../shared run build",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm --prefix ../shared run build",
    "test": "vitest run",
    "pretypecheck": "npm --prefix ../shared run build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "demo:reset": "tsx src/demo/resetDemo.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@serversentinel/contracts": "1.12.2",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.11.3",
    "undici": "^8.10.0",
    "ws": "^8.21.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  }
}
